#!/bin/bash
# desc: テスト用の模擬 dig コマンド。環境変数 MOCK_DNS_ZONE のゾーンファイルから応答を返す
#
# check_mpic.sh が使う次の呼び出し方だけに対応する
#   dig <name> [@server] +noall +comments   … ステータス(NOERROR / NXDOMAIN / SERVFAIL)の確認
#   dig +short <type> <name> [@server]      … レコードの値のみ
#   dig <type> <name> [@server] +noall +answer … 所有者名付きの応答
#   dig <type> <name> [@server] +noall +comments +answer … ステータスと所有者名付きの応答
#   dig NS <name> @server +norecurse +noall +comments +answer +authority +additional
#                                              … 親ゾーンの委任情報 (NSと、そのAレコード(グルー))
# +time / +tries などそれ以外のオプションは無視する
#
# ゾーンファイルの形式 (空白区切り、# 以降はコメント)
#   <リゾルバ> <名前> <タイプ> <値...>
#   - リゾルバは "*"(すべて) / "default"(@指定なし) / "8.8.8.8" などのサーバ名
#   - ある名前についてリゾルバ固有の行があれば、その名前では "*" の行より優先する
#   - リゾルバ固有の行では名前に "*" を書くと、そのリゾルバへのすべての問い合わせに効く
#     (例: "192.0.2.82 * STATUS TIMEOUT" で、応答しない権威DNSサーバーを表す)
#   - タイプ STATUS は応答ステータスを上書きする (SERVFAIL / NXDOMAIN / REFUSED / TIMEOUT)
#   - +authority は無視する (委任のNSも回答として出す)。+additional を付けたNSの問い合わせでは、
#     そのサーバーから見たNS名のAレコードをグルーとして出す
#   - +norecurse は無視する (権威DNSサーバーもIPアドレスをリゾルバ名として同じように扱う)
#   - タイプ DNSSEC の値 BOGUS は、そのリゾルバでDNSSECの検証に失敗するゾーンを表す
#     (例: "8.8.8.8 bogus.ac.jp DNSSEC BOGUS")。ゾーン内と配下の名前は SERVFAIL になり、
#     署名の検証を省く +cd を付けると通常どおり解決できる
#   - CNAME は問い合わせタイプが CNAME 以外ならたどる。名前自身か配下にレコードがなければ NXDOMAIN

#
# 環境変数 MOCK_DNS_DELAY に秒数を指定すると、タイムアウトと SERVFAIL の応答を返す前にその秒数だけ待つ
# (応答しないドメインで、待ち時間がどれだけ積み重なるかを確かめるため。テストでは指定しない)

# 環境変数 MOCK_DNS_LOG にファイル名を指定すると、呼び出されたときの引数を1行ずつ追記する
# (同じ問い合わせを2回実行していないかを確かめるため)

zone=${MOCK_DNS_ZONE:?MOCK_DNS_ZONE が設定されていません}
[ -n "$MOCK_DNS_LOG" ] && echo "$*" >> "$MOCK_DNS_LOG"

short=0
cd=0
comments=0
answer=0
additional=0
server="default"
qtype="A"
qname=""
for arg in "$@"; do
    case "$arg" in
        +short) short=1 ;;
        +cd) cd=1 ;;
        +answer) answer=1 ;;
        +comments) comments=1 ;;
        +additional) additional=1 ;;
        +*) ;;
        @*) server=${arg#@} ;;
        A|AAAA|CAA|CNAME|TXT|NS|SOA|DS|DNSKEY) qtype=$arg ;;
        *) qname=$arg ;;
    esac
done
qname=$(echo "${qname%.}" | tr '[:upper:]' '[:lower:]')

# 指定したリゾルバから見た名前のレコードを "タイプ 値" の形で出力する
records() {
    awk -v res="$server" -v name="$1" '
        /^[ \t]*(#|$)/ { next }
        $3 == "DNSSEC" { next }
        {
            n = tolower($2)
            sub(/\.$/, "", n)
            v = $0
            sub(/^[ \t]*[^ \t]+[ \t]+[^ \t]+[ \t]+/, "", v)
            if ($1 == res && n == "*") all[++na] = v
            if (n != name) next
            if ($1 == res) spec[++ns] = v
            else if ($1 == "*") gen[++ng] = v
        }
        END {
            if (na > 0) { for (i = 1; i <= na; i++) print all[i] }
            else if (ns > 0) { for (i = 1; i <= ns; i++) print spec[i] }
            else { for (i = 1; i <= ng; i++) print gen[i] }
        }' "$zone"
}

# 名前自身か配下に何らかのレコードがあれば存在するとみなす
exists() {
    awk -v res="$server" -v name="$1" '
        /^[ \t]*(#|$)/ { next }
        $3 == "DNSSEC" { next }
        $1 != res && $1 != "*" { next }
        $3 == "STATUS" { next }
        {
            n = tolower($2)
            sub(/\.$/, "", n)
            if (n == name || substr(n, length(n) - length(name)) == "." name) { found = 1; exit }
        }
        END { exit !found }' "$zone"
}

# このリゾルバでDNSSECの検証に失敗するゾーン(またはその配下)の名前か
is_bogus() {
    awk -v res="$server" -v name="$1" '
        /^[ \t]*(#|$)/ { next }
        ($1 == res || $1 == "*") && $3 == "DNSSEC" && $4 == "BOGUS" {
            z = tolower($2)
            sub(/\.$/, "", z)
            if (name == z || substr(name, length(name) - length(z)) == "." z) { found = 1; exit }
        }
        END { exit !found }' "$zone"
}

status="NOERROR"
answers=""
current=$qname
for _ in 1 2 3 4 5 6 7 8; do
    if [ $cd -eq 0 ] && is_bogus "$current"; then
        status="SERVFAIL"
        break
    fi

    recs=$(records "$current")

    st=$(echo "$recs" | awk '$1 == "STATUS" { print $2; exit }')
    if [ -n "$st" ]; then
        status=$st
        break
    fi

    target=$(echo "$recs" | awk '$1 == "CNAME" { print $2; exit }')
    if [ -n "$target" ] && [ "$qtype" != "CNAME" ]; then
        target=$(echo "${target%.}" | tr '[:upper:]' '[:lower:]')
        answers+="$current. 300 IN CNAME $target."$'\n'
        current=$target
        continue
    fi

    if ! exists "$current"; then
        status="NXDOMAIN"
        break
    fi

    while read -r value; do
        [ -z "$value" ] && continue
        if [ "$qtype" == "CNAME" ] || [ "$qtype" == "NS" ]; then
            value="${value%.}."
        fi
        answers+="$current. 300 IN $qtype $value"$'\n'
    done <<< "$(echo "$recs" | awk -v t="$qtype" '$1 == t { sub(/^[^ \t]+[ \t]+/, ""); print }')"
    break
done

if [ $additional -eq 1 ] && [ "$qtype" == "NS" ] && [ "$status" == "NOERROR" ]; then
    while read -r ns; do
        [ -z "$ns" ] && continue
        ns=$(echo "${ns%.}" | tr '[:upper:]' '[:lower:]')
        while read -r addr; do
            [ -n "$addr" ] && answers+="$ns. 300 IN A $addr"$'\n'
        done <<< "$(records "$ns" | awk '$1 == "A" { print $2 }')"
    done <<< "$(records "$current" | awk '$1 == "NS" { print $2 }')"
fi

if [ -n "$MOCK_DNS_DELAY" ] && { [ "$status" == "TIMEOUT" ] || [ "$status" == "SERVFAIL" ]; }; then
    sleep "$MOCK_DNS_DELAY"
fi

if [ "$status" == "TIMEOUT" ]; then
    echo ";; connection timed out; no servers could be reached"
    exit 9
fi

if [ $short -eq 1 ]; then
    printf '%s' "$answers" | awk '{ $1 = $2 = $3 = $4 = ""; sub(/^ +/, ""); print }'
else
    if [ $comments -eq 1 ]; then
        echo ";; ->>HEADER<<- opcode: QUERY, status: $status, id: 1"
    fi
    # +comments だけのときはステータスのみ (+answer を付けたときか、どちらもないときは応答を出す)
    if [ $comments -eq 0 ] || [ $answer -eq 1 ]; then
        printf '%s' "$answers"
    fi
fi
